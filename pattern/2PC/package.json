{
  "name": "2pc-distributed-transaction",
  "version": "1.0.0",
  "description": "Two-Phase Commit distributed transaction pattern implementation in NestJS",
  "main": "index.js",
  "scripts": {
    "build": "nest build",
    "build:payment": "nest build payment-service",
    "build:inventory": "nest build inventory-service",
    "build:order": "nest build order-service",
    "start": "nest start",
    "start:payment": "nest start payment-service",
    "start:inventory": "nest start inventory-service",
    "start:order": "nest start order-service",
    "start:dev": "concurrently \"npm run start:payment\" \"npm run start:inventory\" \"npm run start:order\"",
    "test": "node test-2pc.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/typeorm": "^10.0.0",
    "axios": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "concurrently": "^8.2.0",
    "mysql2": "^3.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "nestjs",
    "2pc",
    "distributed-transactions",
    "ecommerce"
  ],
  "author": "System Design Team",
  "license": "MIT"
}
